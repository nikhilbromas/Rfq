{
  "quotehub": {
    "version": "1.0.0",
    "description": "QuoteHub Mobile App Design Tokens",
    "colors": {
      "primary": {
        "50": "#F3EFFF",
        "100": "#E8DFFF",
        "200": "#D1BFFF",
        "300": "#BA9FFF",
        "400": "#A37FFF",
        "500": "#8C5FFF",
        "600": "#6C4DFF",
        "700": "#5C3DE0",
        "800": "#4C2DC7",
        "900": "#3C1DAE",
        "default": "#6C4DFF"
      },
      "secondary": {
        "default": "#7B61FF",
        "dark": "#6B51EF"
      },
      "accent": {
        "default": "#00C896",
        "dark": "#00B885"
      },
      "warning": {
        "default": "#FFB547",
        "dark": "#FFA520"
      },
      "danger": {
        "default": "#FF5A5F",
        "dark": "#FF3A40"
      },
      "success": {
        "default": "#2ECC71",
        "dark": "#27AE60"
      },
      "neutral": {
        "0": "#FFFFFF",
        "50": "#F8F9FC",
        "100": "#F3F4F6",
        "200": "#E5E7EB",
        "300": "#D1D5DB",
        "400": "#9CA3AF",
        "500": "#6B7280",
        "600": "#4B5563",
        "700": "#374151",
        "800": "#1F2937",
        "900": "#111827",
        "950": "#0F172A"
      },
      "background": {
        "light": "#F8F9FC",
        "dark": "#0F172A"
      },
      "surface": {
        "light": "#FFFFFF",
        "dark": "#1A2637"
      },
      "text": {
        "primary": "#111827",
        "secondary": "#6B7280",
        "tertiary": "#9CA3AF",
        "inverse": "#FFFFFF"
      },
      "border": {
        "light": "#E5E7EB",
        "dark": "#374151"
      }
    },
    "typography": {
      "fontFamilies": {
        "heading": "SF Pro Display",
        "body": "Inter"
      },
      "fontWeights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeights": {
        "tight": 1.2,
        "normal": 1.5,
        "relaxed": 1.75
      },
      "scales": {
        "xs": {
          "fontSize": 12,
          "lineHeight": 16,
          "fontFamily": "Inter",
          "fontWeight": 400
        },
        "sm": {
          "fontSize": 13,
          "lineHeight": 18,
          "fontFamily": "Inter",
          "fontWeight": 400
        },
        "base": {
          "fontSize": 14,
          "lineHeight": 20,
          "fontFamily": "Inter",
          "fontWeight": 400
        },
        "lg": {
          "fontSize": 16,
          "lineHeight": 24,
          "fontFamily": "Inter",
          "fontWeight": 500
        },
        "xl": {
          "fontSize": 18,
          "lineHeight": 28,
          "fontFamily": "SF Pro Display",
          "fontWeight": 700
        },
        "2xl": {
          "fontSize": 22,
          "lineHeight": 32,
          "fontFamily": "SF Pro Display",
          "fontWeight": 700
        },
        "3xl": {
          "fontSize": 28,
          "lineHeight": 36,
          "fontFamily": "SF Pro Display",
          "fontWeight": 700
        },
        "4xl": {
          "fontSize": 32,
          "lineHeight": 40,
          "fontFamily": "SF Pro Display",
          "fontWeight": 700
        }
      }
    },
    "spacing": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "borderRadius": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "base": 12,
      "md": 16,
      "lg": 20,
      "xl": 24,
      "full": 9999
    },
    "shadows": {
      "none": "0px 0px 0px rgba(0, 0, 0, 0)",
      "sm": "0px 2px 4px rgba(0, 0, 0, 0.05)",
      "base": "0px 4px 12px rgba(0, 0, 0, 0.08)",
      "md": "0px 8px 24px rgba(0, 0, 0, 0.12)",
      "lg": "0px 12px 32px rgba(0, 0, 0, 0.15)",
      "xl": "0px 16px 48px rgba(0, 0, 0, 0.20)"
    },
    "components": {
      "button": {
        "base": {
          "padding": "12px 16px",
          "borderRadius": 12,
          "fontWeight": 500,
          "fontSize": 14,
          "fontFamily": "Inter",
          "transitionDuration": "200ms",
          "minHeight": 48
        },
        "primary": {
          "background": "#6C4DFF",
          "color": "#FFFFFF",
          "hover": {
            "background": "#5C3DE0",
            "shadow": "0px 4px 12px rgba(108, 77, 255, 0.3)"
          },
          "active": {
            "background": "#4C2DC7",
            "transform": "scale(0.98)"
          },
          "disabled": {
            "background": "#D1BFFF",
            "color": "#FFFFFF",
            "opacity": 0.5
          }
        },
        "secondary": {
          "background": "#7B61FF",
          "color": "#FFFFFF",
          "hover": {
            "background": "#6B51EF"
          }
        },
        "outline": {
          "background": "#FFFFFF",
          "color": "#111827",
          "border": "2px solid #E5E7EB",
          "hover": {
            "border": "2px solid #6C4DFF",
            "color": "#6C4DFF"
          }
        }
      },
      "card": {
        "base": {
          "background": "#FFFFFF",
          "borderRadius": 16,
          "padding": "16px",
          "border": "1px solid #E5E7EB",
          "shadow": "0px 4px 12px rgba(0, 0, 0, 0.08)"
        },
        "hover": {
          "shadow": "0px 8px 24px rgba(0, 0, 0, 0.12)",
          "transform": "translateY(-2px)",
          "transitionDuration": "200ms"
        }
      },
      "input": {
        "base": {
          "height": 48,
          "borderRadius": 12,
          "padding": "12px",
          "border": "1px solid #E5E7EB",
          "fontSize": 14,
          "fontFamily": "Inter",
          "transitionDuration": "200ms"
        },
        "focus": {
          "borderColor": "#6C4DFF",
          "boxShadow": "0px 0px 0px 3px rgba(108, 77, 255, 0.1)",
          "outline": "none"
        },
        "error": {
          "borderColor": "#FF5A5F",
          "boxShadow": "0px 0px 0px 3px rgba(255, 90, 95, 0.1)"
        }
      },
      "chip": {
        "base": {
          "height": 32,
          "borderRadius": 16,
          "padding": "6px 12px",
          "fontSize": 12,
          "fontWeight": 500,
          "fontFamily": "Inter",
          "border": "1px solid #E5E7EB",
          "background": "#F8F9FC",
          "color": "#111827"
        }
      },
      "badge": {
        "base": {
          "borderRadius": 8,
          "padding": "6px 12px",
          "fontSize": 12,
          "fontWeight": 600,
          "fontFamily": "Inter"
        },
        "sizes": {
          "sm": {
            "padding": "4px 8px",
            "fontSize": 11
          },
          "md": {
            "padding": "6px 12px",
            "fontSize": 12
          },
          "lg": {
            "padding": "8px 16px",
            "fontSize": 13
          }
        }
      }
    },
    "animations": {
      "easing": {
        "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
        "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
        "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
        "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
      },
      "durations": {
        "fast": "150ms",
        "base": "300ms",
        "slow": "500ms"
      },
      "transitions": {
        "buttonPress": {
          "properties": ["transform", "box-shadow"],
          "duration": "150ms",
          "timingFunction": "ease-in-out"
        },
        "pageTransition": {
          "properties": ["opacity", "transform"],
          "duration": "300ms",
          "timingFunction": "ease-out"
        },
        "cardHover": {
          "properties": ["transform", "box-shadow"],
          "duration": "200ms",
          "timingFunction": "ease-out"
        }
      }
    }
  }
}
